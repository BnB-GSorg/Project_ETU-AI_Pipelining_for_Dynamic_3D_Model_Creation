# EditorConfig - https://editorconfig.org
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C/C++ files
[*.{c,cpp,cc,cxx,h,hpp,hxx}]
indent_size = 4

# CMake
[CMakeLists.txt]
indent_size = 4

[*.cmake]
indent_size = 4

# Python
[*.py]
indent_size = 4
max_line_length = 100

# JavaScript/TypeScript (if any)
[*.{js,ts,jsx,tsx}]
indent_size = 2

# JSON
[*.json]
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false

# Makefiles require tabs
[Makefile]
indent_style = tab

# Shell scripts
[*.sh]
indent_size = 4

# TOML
[*.toml]
indent_size = 4

# Windows batch files
[*.{bat,cmd}]
end_of_line = crlf
